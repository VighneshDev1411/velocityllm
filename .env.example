# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15
SERVER_WRITE_TIMEOUT=15
SERVER_IDLE_TIMEOUT=60

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=velocityllm
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Application Configuration
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=info

# Authentication
# Secret used to sign JWTs (use a long random string in production)
JWT_SECRET=change-me-in-production

# OAuth2 (Google / GitHub). Leave blank to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Bare backend origin used to build the OAuth callback URL — NO /api/v1 suffix.
# The callback path (/api/v1/auth/oauth/callback) is appended in code.
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# Frontend origin the backend redirects back to after OAuth.
FRONTEND_URL=http://localhost:3000

# Frontend → backend API base. Bare origin, NO /api/v1 suffix (appended in code).
NEXT_PUBLIC_API_URL=http://localhost:8080